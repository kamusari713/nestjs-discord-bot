import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { isNowInWindowUtc } from '../sleep/utils/is-now-in-window-utc.util';
import { CreateGuildDto } from './dto/create-guild.dto';
import { Guild } from './entities/guild.entity';
import { Policy } from './types/policy.type';

@Injectable()
export class GuildRepository {
  constructor(
    @InjectRepository(Guild)
    private readonly guildRepository: Repository<Guild>,
  ) {}

  async findAll(): Promise<Guild[] | null> {
    const guilds = await this.guildRepository.find();
    return guilds;
  }

  async findAllEnabled(): Promise<Guild[] | null> {
    const guilds = await this.guildRepository.find({
      where: { enabled: true },
    });
    return guilds;
  }

  async findById(id: string) {
    const guild = await this.guildRepository.findOneBy({ id: id });
    if (guild) return guild;
    throw new NotFoundException();
  }

  async upsert(guild: CreateGuildDto) {
    const guildEntity = await this.guildRepository.findOneBy({ id: guild.id });

    if (guildEntity) {
      await this.guildRepository.update({ id: guild.id }, { revoked: false });
      return guild;
    }

    await this.guildRepository.save({
      id: guild.id,
      name: guild.name,
      startHour: guild.startHour,
      startMinute: guild.startMinute || 0,
      endHour: guild.endHour,
      endMinute: guild.endMinute || 0,
      timezone: guild.timezone,
      enabled: guild.enabled || false,
      active: isNowInWindowUtc(
        guild.startHour,
        guild.startMinute || 0,
        guild.endHour,
        guild.endMinute || 0,
        guild.timezone,
      ),
      policy: guild.policy || Policy.MOVE,
    });
  }

  async revokeById(id: string) {
    await this.guildRepository.update({ id: id }, { revoked: true });
  }
}
